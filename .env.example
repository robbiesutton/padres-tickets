# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/benchbuddy?sslmode=require"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Resend (email)
RESEND_API_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ANNUAL_ID=""

# Cron job authentication
CRON_SECRET=""

# A View From My Seat (seat view photos)
AVFMS_API_KEY=""

# ─── Testing (E2E + CI) ───────────────────────────────────────

# Mailosaur — email capture for magic-link and claim confirmation tests
MAILOSAUR_API_KEY=""
MAILOSAUR_SERVER_ID=""

# Set to mailosaur server domain in CI (e.g. abc123.mailosaur.net)
# Leave blank locally to skip email tests
TEST_EMAIL_DOMAIN=""

# Test user credentials (used by seed-test.ts and Playwright globalSetup)
TEST_HOLDER_EMAIL=""       # defaults to holder@{TEST_EMAIL_DOMAIN}
TEST_HOLDER_PASSWORD=""    # defaults to password123
TEST_CLAIMER_EMAIL=""      # defaults to claimer@{TEST_EMAIL_DOMAIN}

# Stripe test mode (separate from production keys)
STRIPE_SECRET_KEY_TEST=""
STRIPE_WEBHOOK_SECRET_TEST=""

# Notion — reporter writes verification pages and failure tasks
NOTION_VERIFICATION_DB_ID=""
NOTION_TASKS_DB_ID=""

# Vercel — for deploying preview from CI and uploading reports to Blob
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""
VERCEL_BLOB_RW_TOKEN=""
